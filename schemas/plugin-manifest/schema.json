{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meshvianex.local/schema/plugin-manifest-v1.json",
  "title": "Meshvianex Plugin Manifest v1",
  "type": "object",
  "required": ["id", "name", "version", "plugin_types", "abi"],
  "properties": {
    "id": {"type":"string", "minLength":3},
    "name": {"type":"string", "minLength":1},
    "version": {"type":"string", "minLength":1},
    "plugin_types": {"type":"array", "items":{"type":"string"}, "minItems":1},
    "requires_capabilities": {"type":"array", "items":{"type":"string"}},
    "optional_capabilities": {"type":"array", "items":{"type":"string"}},
    "provides": {"type":"array", "items":{"type":"string"}},
    "requires_api": {"type":"object", "additionalProperties":{"type":"string"}},
    "optional_api": {"type":"object", "additionalProperties":{"type":"string"}},
    "dependencies": {"type":"array", "items":{"type":"object", "required":["plugin"], "properties":{"plugin":{"type":"string"},"version":{"type":"string"},"optional":{"type":"boolean"}}, "additionalProperties":false}},
    "runtime": {"type":"object", "properties":{"type":{"type":"string"},"entry":{"type":"string"}}, "additionalProperties":false},
    "config_schema": {"$ref":"../ui/schema.json#/$defs/config_schema"},
    "abi": {"const":1}
  },
  "additionalProperties": true
}
