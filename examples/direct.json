{
  "realm": {
    "id": "local",
    "name": "Local HTTP Proxy",
    "routing": {
      "instance_id": "rules-main",
      "plugin": "io.meshvianex.rules.basic",
      "enabled": true,
      "config": {"default":"direct-main","rules":[]}
    },
    "dns": [{"instance_id":"dns-main","plugin":"io.meshvianex.dns.system","enabled":true,"config":{}}],
    "outbounds": [{"instance_id":"direct-main","plugin":"io.meshvianex.direct","enabled":true,"config":{"timeout_seconds":15}}],
    "inbounds": [{"instance_id":"http-local","plugin":"io.meshvianex.inbound.http","enabled":true,"config":{"listen":"127.0.0.1:8080"}}],
    "default_outbound": "direct-main"
  },
  "ui": {"enabled":true,"config":{"listen":"127.0.0.1:8787","title":"Meshvianex"}}
}
